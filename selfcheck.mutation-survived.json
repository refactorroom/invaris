{
  "version": "invaris.dev/v1alpha3",
  "name": "invaris-selfcheck",
  "trustMode": "trusted-local",
  "networkPolicy": "unrestricted",
  "writablePaths": [
    "internal/mutation/operators.go"
  ],
  "experiment": {
    "id": "selfcheck-survived",
    "mutation": {
      "id": "survived-edit",
      "operator": "replace",
      "path": "internal/mutation/operators.go",
      "before": "ineligible(\"empty file\")",
      "after": "ineligible(\"empty input\")",
      "preimageSha256": "d3487c2990379e4b5b6a31c52b924be8d57dbafdd0a80a644f81ac0d55f441c2"
    },
    "validation": {
      "id": "vet",
      "program": "sh",
      "args": [
        "-c",
        "if go vet ./internal/mutation >&2; then echo '{\"version\":\"invaris.validity-result/v1alpha1\",\"status\":\"VALID\"}'; else echo '{\"version\":\"invaris.validity-result/v1alpha1\",\"status\":\"INVALID\"}'; exit 1; fi"
      ],
      "envAllowlist": [
        "PATH",
        "HOME",
        "GOTOOLCHAIN",
        "GOPROXY",
        "GOFLAGS"
      ],
      "timeoutSeconds": 300
    },
    "test": {
      "id": "go-tests",
      "program": "sh",
      "args": [
        "-c",
        "go test -json -count=1 -run '^(TestPlanGoldens|TestPlanIneligibleInputs|TestValidate)$' ./internal/mutation | invaris test-result go-test-json"
      ],
      "envAllowlist": [
        "PATH",
        "HOME",
        "GOTOOLCHAIN",
        "GOPROXY",
        "GOFLAGS"
      ],
      "timeoutSeconds": 300
    },
    "testIds": [
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanGoldens/whitespace_first_line",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanGoldens/whitespace_skips_empty_and_already-trailing_lines",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanGoldens/whitespace_ignores_unterminated_last_line",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanGoldens/whitespace_unicode",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanGoldens/crlf_first_LF_only",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanGoldens/crlf_leading_empty_line",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanGoldens/secret_appended",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanGoldens",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/empty/trailing-whitespace",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/empty/crlf-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/empty/secret-leak-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/NUL/trailing-whitespace",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/NUL/crlf-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/NUL/secret-leak-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/invalid_UTF-8/trailing-whitespace",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/invalid_UTF-8/crlf-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/invalid_UTF-8/secret-leak-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/CRLF/trailing-whitespace",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/CRLF/crlf-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/CRLF/secret-leak-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/mixed_endings/trailing-whitespace",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/mixed_endings/crlf-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/mixed_endings/secret-leak-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/lone_CR/trailing-whitespace",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/lone_CR/crlf-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/lone_CR/secret-leak-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/oversized/trailing-whitespace",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/oversized/crlf-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/oversized/secret-leak-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/result_over_limit/trailing-whitespace",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/result_over_limit/crlf-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/secret_result_over_limit/secret-leak-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/no_newline/trailing-whitespace",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/no_newline/crlf-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/no_newline/secret-leak-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/every_line_already_trailing/trailing-whitespace",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/secret_without_final_LF/secret-leak-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs/secret_already_present/secret-leak-injection",
      "github.com/akkaraponph/invaris/internal/mutation.TestPlanIneligibleInputs",
      "github.com/akkaraponph/invaris/internal/mutation.TestValidate"
    ]
  }
}
